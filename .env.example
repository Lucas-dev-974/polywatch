# Database — PostgreSQL (required)
DATABASE_URL=postgresql://polywatch:***@localhost:5432/polywatch

# Auth (set BYPASS_SECRET_SECURITY=true to skip secret checks in local dev only)
BYPASS_SECRET_SECURITY=false
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32
SERVICE_TOKEN=change-me-service-token-min-32-chars
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Worker / crypto-algo → backend
BACKEND_URL=http://localhost:3000

# Default admin (seeded on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Polymarket
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_WS_USER_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

# Polygonscan / Etherscan API v2 (chainid=137) — optional if configured via UI (Integration settings)
POLYGONSCAN_API_KEY=

# Market position tick persistence (1 row per open position on each book update)
# MARKET_TICK_RETENTION_DAYS=30
# MARKET_TICK_THROTTLE_MS=500
# MARKET_TICK_REF_QTY=100

# Crypto-algo
# CRYPTO_ALGO_POLL_MS=30000